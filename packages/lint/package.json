{
  "name": "@reebeat/lint",
  "version": "0.1.0-alpha.0",
  "description": "reebeat lint: pure rules that return diagnostics for a Plan. Pure, no runtime.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "directory": "dist"
  },
  "scripts": {
    "test": "bunx vp test",
    "check": "vp check",
    "prepublishOnly": "echo 'publish the staged dist (bun run release:stage), never this directory' && exit 1"
  },
  "dependencies": {
    "@reebeat/core": "workspace:*"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "effect": "^4.1.0"
  }
}
