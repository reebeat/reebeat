{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": ["tools/oxlint/anti-slop/**"],
  "ignoreDependencies": ["@effect/language-service", "vite"],
  "workspaces": {
    "packages/core": {
      "entry": ["test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/deck": {
      "entry": ["test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"],
      "ignoreDependencies": ["@fontsource/inter", "reveal.js"]
    },
    "tools/quality": {
      "entry": ["checkEffectExceptions.ts"],
      "project": ["*.ts", "test/**/*.ts"]
    }
  },
  "ignoreBinaries": ["gitleaks"]
}
