{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": ["tools/oxlint/anti-slop/**"],
  "ignoreDependencies": ["@effect/language-service", "vite"],
  "workspaces": {
    "packages/core": {
      "entry": ["test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/speech": {
      "entry": ["test/**/*.test.ts", "live/**/*.test.ts", "scripts/*.ts"],
      "project": [
        "src/**/*.ts",
        "test/**/*.ts",
        "live/**/*.ts",
        "scripts/**/*.ts"
      ]
    },
    "tools/quality": {
      "entry": ["checkEffectExceptions.ts"],
      "project": ["*.ts", "test/**/*.ts"]
    }
  },
  "ignoreBinaries": ["gitleaks"]
}
