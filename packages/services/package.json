{
  "name": "@reebeat/services",
  "version": "0.0.0",
  "description": "reebeat services: the seven service interfaces, their errors, contract suites and offline stand-ins.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./contract": "./contract/index.ts",
    "./standins": "./standins/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "directory": "dist"
  },
  "scripts": {
    "test": "bunx vp test",
    "check": "vp check",
    "prepublishOnly": "echo 'publish the staged dist (bun run release:stage), never this directory' && exit 1"
  },
  "dependencies": {
    "@reebeat/core": "workspace:*"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@effect/vitest": "~4.1.0",
    "effect": "~4.1.0"
  },
  "peerDependenciesMeta": {
    "@effect/vitest": {
      "optional": true
    }
  }
}
